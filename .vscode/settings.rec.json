{
    "terminal.integrated.env.linux": {
        "EXT_PATH": "${workspaceFolder}/build/bin",
    },
    "terminal.integrated.env.osx": {
        "EXT_PATH": "${workspaceFolder}/build/bin",
        "TRITON_DEBUG": "1",
        "TRITON_HOME": "${workspaceFolder}/_demos",
        "TRITON_ALWAYS_COMPILE": "1",
        //
        "MLIR_ENABLE_DIAGNOSTICS": "1",
        "MLIR_ENABLE_DUMP": "1",
        "MLIR_ENABLE_DUMP_DIR": "${workspaceFolder}/_demos/.pass_manager_output",
        "LLVM_IR_ENABLE_DUMP": "1",
        //
        // "TRITON_MOCK_PTX_VERSION": "84",
    },
    // use abs path
    "mlir.server_path": "${workspaceFolder}/build/bin/triton-lsp",
    "mlir.tablegen_server_path": "${workspaceFolder}/llvm-triton/llvm-project/build/bin/tblgen-lsp-server",
}
